      <label>Winter CTR (Dec-Feb)</label>
                                    <div style="display: flex; gap: 8px;">
                                        <input type="number" id="newTerrWinter" value="3.0" min="0" step="0.1" style="flex: 1;" onchange="calculateBlendedCtr()">
                                        <span style="padding: 10px; color: #999;">%</span>
                                    </div>
                                </div>
                            </div>
                            <div style="padding: 12px; background: #f9f9f9; border-radius: 4px; margin-top: 10px;">
                                <div style="font-size: 12px; font-weight: bold; color: #666;">Blended Annual Average: <span id="blendedCalc" style="color: #b69d5e;">3.98%</span></div>
                            </div>
                        </div>

                        <div class="grid">
                            <div class="form-group">
                                <label>Notes</label>
                                <input type="text" id="newTerrNotes" placeholder="e.g., Year-round market, Seasonal, Peak season only">
                            </div>
                        </div>
                        <button id="terrSaveBtn" onclick="addTerritory()" style="background: #438148;">➕ Add Territory</button>
                        <button id="terrCancelBtn" onclick="cancelEditTerritory()" style="background: #999; display: none;">Cancel Edit</button>
                    </div>
                </div>
            </div>

            <!-- TAB 3: Saved Scenarios -->
            <div id="scenarios" class="tab-content">
                <div class="section">
                    <div class="section-title">Your Saved Scenarios</div>
                    <div class="form-note" style="margin-bottom: 20px;">Check the box to mark a scenario as "Active" (the one currently in use). Scenarios are saved with timestamps — the latest version appears first.</div>
                    
                    <div class="scenario-list" id="scenarioList">
                        <p style="color: #999; padding: 20px; text-align: center;">No scenarios saved yet. Build and save one above.</p>
                    </div>

                    <div style="border-top: 2px solid #e0e0e0; padding-top: 20px; margin-top: 20px; text-align: center;">
                        <button onclick="exportScenarios()" style="background: #b69d5e; margin-right: 10px;">⬇️ Backup All Scenarios (.json)</button>
                        <button onclick="clearAllScenarios()" style="background: #d32f2f;">🗑️ Clear All Scenarios</button>
                    </div>
                </div>
            </div>

            <!-- TAB: Advertising Campaign Blueprints -->
            <div id="blueprints" class="tab-content">
                <div class="section">
                    <div class="section-title">Advertising Campaign Blueprints</div>
                    <div class="form-note" style="margin-bottom: 20px;">Locked-in, labeled combinations of compared scenarios saved for the advertising specialist. To change a blueprint, go find and adjust the underlying scenario(s) in Saved Scenarios, then lock in a new blueprint from the Compare Scenarios tab.</div>
                    <div class="scenario-list" id="blueprintList">
                        <p style="color: #999; padding: 20px; text-align: center;">No blueprints saved yet. Go to Compare Scenarios, select the scenarios you want, and click "Lock as Advertising Blueprint".</p>
                    </div>
                </div>
            </div>

            <!-- TAB 4: Scenario Comparison -->
            <div id="comparison" class="tab-content">
                <div class="section">
                    <div class="section-title">Compare Multiple Scenarios</div>
                    <div class="form-note" style="margin-bottom: 20px;">Select up to 3 scenarios to compare side-by-side ROI projections.</div>
                    
                    <div class="grid three-col">
                        <div class="form-group">
                            <label>Scenario 1</label>
                            <select id="compareScen1" onchange="updateComparison()">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Scenario 2</label>
                            <select id="compareScen2" onchange="updateComparison()">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Scenario 3</label>
                            <select id="compareScen3" onchange="updateComparison()">
                                <option value="">-- Select --</option>
                            </select>
                        </div>
                    </div>

                    <div class="comparison-grid" id="comparisonGrid" style="margin-top: 30px;">
                        <p style="color: #999; grid-column: 1/-1; text-align: center;">Select scenarios to compare</p>
                    </div>
                    <div style="text-align: center; margin-top: 20px;">
                        <button onclick="lockComparisonAsBlueprint()" style="background: #b69d5e;">🔒 Lock as Advertising Blueprint</button>
                    </div>
                </div>

            </div>
            <!-- TAB 6: Disclaimer & Updates -->
            <div id="info" class="tab-content">
                <div class="section">
                    <div class="section-title">Disclaimer</div>
                    <div style="font-size: 12px; line-height: 1.6; color: #666; background: #fff8e6; border: 1px solid #b69d5e; border-radius: 6px; padding: 12px 16px;">
                        There is no guarantee