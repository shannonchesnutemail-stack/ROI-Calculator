          const approvedExact = leadsExact * ACCULYNX_DATA.approvalRate;
            const closedExact = approvedExact * ACCULYNX_DATA.closeRate;
            const leads = Math.floor(leadsExact);
            const approved = Math.floor(approvedExact);
            const closed = Math.floor(closedExact);
            const revenue = closed * ticket;
            const profit = revenue * margin;
            const roi = adSpend > 0 ? ((profit - adSpend) / adSpend) * 100 : 0;

            // Max Affordable CPL = Ticket x Margin% x Marketing Budget% x Effective Close Rate (Acculynx: 33% x 83%)
            const maxCpl = ticket * margin * marketingBudgetPct * effectiveCloseRate;

            // Wire CTR + verified landing page conversion rate into a real funnel calc:
            // Clicks = Leads / CVR%   |   Impressions = Clicks / CTR%
            // Only shown when a verified CVR exists for this territory — no CVR means no guess.
            const clicksEl = document.getElementById('resultClicks');
            const impressionsEl = document.getElementById('resultImpressions');
            if (lpConvRatePct > 0) {
                const clicksExact = leadsExact / (lpConvRatePct / 100);
                clicksEl.textContent = Math.round(clicksExact).toLocaleString('en-US');
                if (ctrPct > 0) {
                    const impressionsExact = clicksExact / (ctrPct / 100);
                    impressionsEl.textContent = Math.round(impressionsExact).toLocaleString('en-US');
                } else {
                    impressionsEl.textContent = 'N/A (no CTR)';
                }
            } else {
                clicksEl.textContent = 'N/A — no verified CVR for this territory';
                impressionsEl.textContent = 'N/A — no verified CVR for this territory';
            }

            // Annual calculations (12 months)
            const annualSpend = adSpend * 12;
            const annualRevenue = revenue * 12;
            const annualProfit = profit * 12;
            const annualROI = annualSpend > 0 ? ((annualProfit - annualSpend) / annualSpend) * 100 : 0;

            // Update monthly results
            document.getElementById('resultSpend').textContent = fmtMoney(adSpend);
            document.getElementById('resultLeads').textContent = leads;
            document.getElementById('resultApproved').textContent = approved;
            document.getElementById('resultClosed').textContent = closed;
            document.getElementById('resultRevenue').textContent = fmtMoney(revenue);
            document.getElementById('resultRevenueRange').textContent = '$' + fmtMoney(revenue * 0.8) + ' - $' + fmtMoney(revenue * 1.2);
            document.getElementById('resultProfit').textContent = fmtMoney(profit);
            document.getElementById('resultProfitRange').textContent = '$' + fmtMoney(profit * 0.8) + ' - $' + fmtMoney(profit * 1.2);
            document.getElementById('resultROI').textContent = Math.round(roi) + '%';

            const maxCplEl = document.getElementById('resultMaxCpl');
            maxCplEl.textContent = Math.floor(maxCpl).toLocaleString('en-US');
            const maxCplStatus = document.getElementById('resultMaxCplStatus');
            if (cpl > 0) {
                if (cpl <= maxCpl) {
                    maxCplStatus.textContent = '✅ Territory CPL ($' + Math.round(cpl).toLocaleString('en-US') + ') is within your max affordable CPL.';
                    maxCplStatus.style.color = '#438148';
                } else {
                    maxCplStatus.textContent = '⚠️ Territory CPL ($' + Math.round(cpl).toLocaleString('en-US') + ') exceeds your max affordable CPL — this scenario is unprofitable at current assumptions.';
                    maxCplStatus.style.color = '#d32f2f';
                }
            } else {
                maxCplStatus.textContent = '';
            }

            // Update annual results
            document.getElementById('resultAnnualRevenue').textContent = fmtMoney(annualRevenue);
            document.getElementById('resultAnnualRevenueRange').textContent = '$' + fmtMoney(annualRevenue * 0.8) + ' - $' + fmtMoney(annualRevenue * 1.2);
            document.getElementById('resultAnnualProfit').textContent = fmtMoney(annualProfit);
            document.getElementById('resultAnnualProfitRange').textContent = '$' + fmtMoney(annualProfit * 0.8) + ' - $' + fmtMoney(annualProfit * 1.2);
            document.getElementById('resultAnnualROI').textContent = Math.round(annualROI) + '%';

            const terrId = document.getElementById('territory').value;
            generateSuggestions({
                terr: TERRITORIES_DB[terrId] || null,
                cpl, ctrPct, lpConvRatePct, adSpend, margin, marketingBudgetPct
            });
        }

        function suggestionRow(icon, cls, html) {
            return `<div class="suggestion-item"><span class="suggestion-icon">${icon}</span><span class="${cls}">${html}</span></div>`;
        }

        // Data-backed, contextual guidance — reacts live to whatever is currently
        // in the Scenario Builder. Grounded in this project's own stored benchmarks
        // (Acculynx funnel, territory CTR/CVR, Murray's 30% margin / 15% marketing
        // budget targets) rather than generic advice, per Shannon's "reliable sources
        // only" requirement.
        function generateSuggestions({ terr, cpl, ctrPct, lpConvRatePct, adSpend, margin, marketingBudgetPct }) {
            const rows = [];

            const verifiedCloseRate = ACCULYNX_DATA.approvalRate * ACCULYNX_DATA.closeRate * 100;
            rows.push(suggestionRow('📌', 'suggestion-info',
                `Plan off the <strong>verified</strong> ${verifiedCloseRate.toFixed(1)}% lead&rarr;close rate (33% approval &times; 83% close, real Acculynx data) rather than a higher target close rate &mdash; an optimistic close rate overstates revenue.`));

            if (terr) {
                const benchmarkCtr = terr.ctrType ===