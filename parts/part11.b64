 'blended' ? terr.blendedCtr : terr.ctr;
                if (benchmarkCtr && ctrPct > 0) {
                    if (ctrPct < benchmarkCtr * 0.85) {
                        rows.push(suggestionRow('⚠️', 'suggestion-warn',
                            `CTR (${ctrPct}%) is below ${terr.name}'s benchmark (${benchmarkCtr}%). A weak CTR usually means a weaker Quality Score, which raises CPC and risks losing impression share to competitors &mdash; tighten keyword-to-ad-copy relevance before raising budget.`));
                    } else {
                        rows.push(suggestionRow('✅', 'suggestion-ok',
                            `CTR (${ctrPct}%) is at or above the ${terr.name} benchmark (${benchmarkCtr}%) &mdash; a healthy signal for Quality Score and CPC efficiency.`));
                    }
                }

                const benchmarkConv = terr.convRate;
                const isVerified = terr.cplSource === 'derived';
                if (benchmarkConv && lpConvRatePct > 0 && lpConvRatePct < benchmarkConv * 0.85) {
                    rows.push(suggestionRow('⚠️', 'suggestion-warn',
                        `Landing Page Conversion (${lpConvRatePct}%) is below ${terr.name}'s ${isVerified ? 'VERIFIED' : 'estimated'} benchmark (${benchmarkConv}%). This is usually the cheapest lever available &mdash; improving the landing page raises leads and revenue faster than raising ad spend, and it now lowers CPL live in this calculator when you edit it.`));
                }
                if (!isVerified) {
                    rows.push(suggestionRow('ℹ️', 'suggestion-info',
                        `${terr.name}'s CPL and conversion rate are still <strong>estimates</strong> pending real campaign data (30-day verification window) &mdash; treat this scenario as directional until verified.`));
                }
            } else {
                rows.push(suggestionRow('ℹ️', 'suggestion-info', 'Select a territory above to unlock benchmark-based suggestions for CTR and landing page conversion.'));
            }

            const MIN_LEADS_FOR_ALGO = 15; // commonly cited Google Smart Bidding guidance: ~15 conversions/30 days per campaign to exit Learning phase
            if (cpl > 0) {
                const minViableBudget = Math.ceil((MIN_LEADS_FOR_ALGO * cpl) / 50) * 50;
                if (adSpend < minViableBudget) {
                    rows.push(suggestionRow('⚠️', 'suggestion-warn',
                        `At $${Math.round(cpl)} CPL, Google's algorithm typically needs ~${MIN_LEADS_FOR_ALGO} conversions/month per campaign to leave Learning phase and optimize &mdash; that's roughly $${minViableBudget.toLocaleString('en-US')}/mo minimum. Your $${Math.round(adSpend).toLocaleString('en-US')}/mo budget may be under the test-budget floor.`));
                } else {
                    rows.push(suggestionRow('✅', 'suggestion-ok',
                        `Budget clears the ~${MIN_LEADS_FOR_ALGO}-conversion/month floor Google's algorithm typically needs to optimize bidding for this CPL.`));
                }
            }

            if (margin > 0 && Math.abs(margin * 100 - 30) > 5) {
                rows.push(suggestionRow('ℹ️', 'suggestion-info',
                    `Gross margin is set to ${(margin * 100).toFixed(0)}% vs. Murray's standard 30% target &mdash; confirm that's intentional for this scenario.`));
            }
            if (marketingBudgetPct > 0 && Math.abs(marketingBudgetPct * 100 - 15) > 5) {
                rows.push(suggestionRow('ℹ️', 'suggestion-info',
                    `Marketing Budget % is set to ${(marketingBudgetPct * 100).toFixed(0)}% vs. the standard 15% target &mdash; this directly moves Max Affordable CPL above.`));
            }

            document.getElementById('suggestionsList').innerHTML = rows.join('');
        }

        function generateUniqueId() {
            // Short, human-readable unique identifier, e.g. "K3F9-7A2"
            const stamp = Date.now().toString(36).toUpperCase().slice(-5);
            const rand = Math.random().toString(36).toUpperCase().slice(2, 5);
            return `${stamp}-${rand}`;
        }

        const ROI_DISCLAIMER_TEXT = "IMPORTANT DISCLAIMER: THERE IS ABSOLUTELY NEVER ANY GUARANTEE THAT YOU WILL HIT THIS EXACT NUMBER OF GENERATED LEADS. THERE IS A MARGINAL SWING OF +20/-20 ON REVENUE DUE TO THE LACK OF LANDING PAGE CONVERSION RATE AND INCONSISTENT CLOSING RATIOS. THERE IS NO GUARANTEE THAT WE WILL REACH THE REVENUE. THE CALCULATOR SHOULD BE USED AS AN INDICATOR OR GUIDE VS. A GUARANTEE. AS EACH SCENARIO IS PLAYED OUT IN OUR ADVERTISING PLATFORM, IT WILL PULL THAT DATA AND REFINE THE PROJECTIONS. The software will deliver the best scenarios based on our personal historical CTR, Landing Page Conversions, CPL expectations, and other similar KPIs to determine the best Google Ads plan.";

        function printDisclaimerHtml() {
            return `<div class="print-disclaimer"><strong>${ROI_DISCLAIMER_TEXT}</strong></div>`;
        }

        function scenarioPrintCardHtml(s) {
            return `
                <div class="print-card">
                    <h3>${s.name}</h3>
                    <div>${TERRITORIES_DB[s.territory]?.name || s.territory} | $${s.cpl} CPL | ${s.ctrType === 'blended' ? 'Blended' : 'Flat'} CTR (${s.ctr}%) | $${Math.round(s.adSpend).toLocaleString('en-US')}/mo spend</div>
                    <div style="margin-top:8px;"><strong>Monthly:</strong> Leads ${s.results.leads} | Approved ${s.results.approved} | Closed ${s.results.closed} | Revenue $${s.results.revenue} | Profit $${s.results.profit} | ROI ${s.results.roi} | Max CPL $${s.results.maxCpl || '0'}</div>
                    <div style="margin-top:4px;"><strong>Annual:</strong> Revenue $${s.results.annualRevenue || '0'} | Profit $${s.results.annualProfit || '0'} | ROI ${s.results.annualROI || '0%'}</div>
                    <div style="margin-top:4px; color:#999;">Saved: ${s.timestamp}</div>
               