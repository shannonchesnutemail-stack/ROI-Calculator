compareScen1', 'compareScen2', 'compareScen3'].map(id => document.getElementById(id).value).filter(Boolean);
            const selected = scenarios.filter(s => ids.includes(s.id));

            const grid = document.getElementById('comparisonGrid');
            if (selected.length === 0) {
                grid.innerHTML = '<p style="color: #999; grid-column: 1/-1; text-align: center;">Select scenarios to compare</p>';
                return;
            }

            grid.innerHTML = selected.map(s => `
                <div class="comparison-card">
                    <div class="comparison-title">${s.name}</div>
                    <div style="font-size: 12px; color: #999; margin-bottom: 15px;">${TERRITORIES_DB[s.territory]?.name || s.territory}</div>
                    <div style="font-size: 13px; line-height: 1.8;">
                        <div><strong>Monthly Spend:</strong> $${Math.round(s.adSpend).toLocaleString('en-US', { minimumFractionDigits: 0, maximumFractionDigits: 0 })}</div>
                        <div><strong>CPL:</strong> $${s.cpl}</div>
                        <div style="border-top: 1px solid #ddd; margin: 10px 0; padding-top: 10px;">
                            <div><strong>Monthly Leads:</strong> ${s.results.leads}</div>
                            <div><strong>Approved:</strong> ${s.results.approved}</div>
                            <div><strong>Closed:</strong> ${s.results.closed}</div>
                            <div><strong>Max Affordable CPL:</strong> $${s.results.maxCpl || '0'}</div>
                        </div>
                        <div style="border-top: 1px solid #ddd; margin: 10px 0; padding-top: 10px; color: #b69d5e; font-weight: bold;">
                            <div style="font-size: 12px; margin-bottom: 8px; color: #999;">Monthly:</div>
                            <div>Revenue: $${s.results.revenue}</div>
                            <div>Profit: $${s.results.profit}</div>
                            <div>ROI: ${s.results.roi}</div>
                            <div style="border-top: 1px solid rgba(182,157,94,0.3); margin: 8px 0; padding-top: 8px; font-size: 12px; color: #999;">Annual:</div>
                            <div>Revenue: $${s.results.annualRevenue || '0'}</div>
                            <div>Profit: $${s.results.annualProfit || '0'}</div>
                            <div>ROI: ${s.results.annualROI || '0%'}</div>
                        </div>
                    </div>
                </div>
            `).join('');
        }

        // ===== Advertising Campaign Blueprints =====

        function lockComparisonAsBlueprint() {
            const scenarios = JSON.parse(localStorage.getItem('murrayScenarios')) || [];
            const ids = ['compareScen1', 'compareScen2', 'compareScen3'].map(id => document.getElementById(id).value).filter(Boolean);
            const selected = scenarios.filter(s => ids.includes(s.id));

            if (selected.length === 0) {
                alert('Select at least one scenario to compare before locking in a blueprint.');
                return;
            }

            const label = prompt('Name this Advertising Blueprint (e.g., "Fall Roofing Push - Lincoln + Omaha"):');
            if (!label || !label.trim()) return;

            const uid = generateUniqueId();
            const blueprint = {
                id: Date.now().toString(),
                uid: uid,
                label: label.trim(),
                name: `${label.trim()} — BP-${uid}`,
                timestamp: new Date().toLocaleString(),
                scenarioIds: selected.map(s => s.id),
                scenarios: JSON.parse(JSON.stringify(selected)) // frozen snapshot at lock time
            };

            let blueprints = JSON.parse(localStorage.getItem('murrayBlueprints')) || [];
            blueprints.push(blueprint);
            blueprints.sort((a, b) => parseInt(b.id) - parseInt(a.id));
            localStorage.setItem('murrayBlueprints', JSON.stringify(blueprints));

            alert(`🔒 Advertising Blueprint locked in: "${blueprint.name}"`);
            loadBlueprints();
            switchTab('blueprints');
        }

        function loadBlueprints() {
            const blueprints = JSON.parse(localStorage.getItem('murrayBlueprints')) || [];
            const list = document.getElementById('blueprintList');
            if (!list) return;

            if (blueprints.length === 0) {
                list.innerHTML = '<p style="color: #999; padding: 20px; text-align: center;">No blueprints saved yet. Go to Compare Scenarios, select the scenarios you want, and click "Lock as Advertising Blueprint".</p>';
                return;
            }

            list.innerHTML = blueprints.map(b => `
                <div class="scenario-item">
                    <div class="scenario-info">
                        <div class="scenario-name">${b.name}</div>
                        <div class="scenario-meta">
                            Combines: ${b.scenarios.map(s => s.name).join(', ')}<br>
                            <span style="font-size: 11px; color: #bbb;">Locked in: ${b.timestamp}</span>
                        </div>
                    </div>
                    <div class="scenario-actions">
                        <button class="secondary" onclick="viewBlueprint('${b.id}')">👁️ View</button>
                        <button onclick="exportBlueprintPDF('${b.id}')" style="background: #438148;">📄 Download PDF</button>
                        <button onclick="deleteBlueprint('${b.id}')" style="background: #d32f2f;">🗑️ Delete</button>
                    </div>
                </div>
            `).join('');
        }

        function findBlueprint(id) {
            const blueprints = JSON.parse(localStorage.getItem('murrayBlueprints')) || [];
            return blueprints.find(b => b.id === id);
        }

