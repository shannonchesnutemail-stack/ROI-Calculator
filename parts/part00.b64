<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Murray ROI Calculator v4.9.0 - Scenario Manager</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: 'Century Gothic', 'Helvetica Neue', sans-serif; background: #f5f5f5; padding: 20px; }
        .container { max-width: 1400px; margin: 0 auto; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        
        /* Header */
        .header { background: #3d3d3d; color: white; padding: 30px; display: flex; align-items: center; gap: 15px; border-radius: 8px 8px 0 0; }
        .logo-img { width: 50px; height: 50px; background: #b69d5e; border-radius: 4px; display: flex; align-items: center; justify-content: center; font-weight: bold; color: white; }
        .header h1 { font-size: 28px; font-weight: bold; color: #b69d5e; }
        .header-subtitle { font-size: 12px; color: #ccc; }
        .header-utility { margin-left: auto; display: flex; gap: 10px; flex-wrap: wrap; justify-content: flex-end; }
        .header-util-btn { background: rgba(255,255,255,0.08); border: 1px solid rgba(255,255,255,0.3); color: #eee; padding: 9px 16px; border-radius: 20px; font-size: 12px; font-weight: bold; cursor: pointer; white-space: nowrap; }
        .header-util-btn:hover { background: rgba(255,255,255,0.18); }
        .header-util-btn.active { background: #b69d5e; border-color: #b69d5e; color: #fff; }
        
        .content { padding: 30px; }
        
        /* Tab System */
        .tabs { display: flex; gap: 0; margin-bottom: 30px; border-bottom: 2px solid #e0e0e0; }
        .tab-button { padding: 12px 20px; background: #f5f5f5; border: none; cursor: pointer; font-weight: bold; color: #999; border-bottom: 3px solid transparent; }
        .tab-button.active { background: white; color: #b69d5e; border-bottom-color: #b69d5e; }
        .tab-content { display: none; }
        .tab-content.active { display: block; }
        
        /* Section */
        .section { margin-bottom: 35px; padding-bottom: 25px; border-bottom: 1px solid #e0e0e0; }
        .section:last-child { border-bottom: none; }
        .section-title { font-size: 16px; font-weight: bold; color: #3d3d3d; margin-bottom: 15px; text-transform: uppercase; letter-spacing: 1px; }
        
        /* Grid Layout */
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px; }
        .grid.full { grid-template-columns: 1fr; }
        .grid.three-col { grid-template-columns: 1fr 1fr 1fr 1fr; }
        
        /* Form Elements */
        .form-group { margin-bottom: 15px; }
        label { display: block; font-size: 13px; font-weight: bold; color: #3d3d3d; margin-bottom: 6px; text-transform: uppercase; }
        input, select, textarea { width: 100%; padding: 10px; border: 1px solid #d0d0d0; border-radius: 4px; font-size: 14px; font-family: inherit; }
        input:focus, select:focus { outline: none; border-color: #b69d5e; box-shadow: 0 0 0 3px rgba(182, 157, 94, 0.1); }
        input[type="checkbox"] { width: auto; margin-right: 8px; }
        button { padding: 10px 20px; background: #438148; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 14px; }
        button:hover { background: #2d5d4f; }
        button.secondary { background: #b69d5e; }
        button.secondary:hover { background: #9b8045; }
        button.danger { background: #d32f2f; }
        button.danger:hover { background: #b71c1c; }
        
        /* Accuracy Box */
        .accuracy-box { background: linear-gradient(135deg, #e8f4f0 0%, #f0f9f7 100%); border: 2px solid #438148; border-radius: 8px; padding: 20px; margin-bottom: 20px; }
        .accuracy-title { font-size: 14px; font-weight: bold; color: #438148; margin-bottom: 12px; }
        .accuracy-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
        .accuracy-item { font-size: 12px; }
        .accuracy-label { font-weight: bold; color: #2d5d4f; display: block; margin-bottom: 3px; }
        .accuracy-value { color: #555; line-height: 1.4; }
        .data-status { display: inline-block; padding: 2px 8px; border-radius: 3px; font-size: 10px; font-weight: bold; margin-top: 4px; }
        .status-real { background: #c8e6c9; color: #2e7d32; }
        .status-pending { background: #fff9c4; color: #f57f17; }
        
        /* Territory Database */
        .territory-list { display: grid; grid-template-columns: repeat(auto-fill, minmax(200px, 1fr)); gap: 15px; margin-bottom: 20px; }
        .territory-card { background: #f9f9f9; padding: 15px; border-radius: 6px; border-left: 4px solid #b69d5e; }
        .territory-name { font-weight: bold; color: #3d3d3d; margin-bottom: 5px; }
        .territory-cpl { font-size: 12px; color: #666; }
        .territory-actions { margin-top: 10px; display: flex; gap: 5px; }
        .territory-actions button { padding: 5px 10px; font-size: 12px; }
        
        /* Scenario List */
        .scenario-list { margin-top: 20px; }
        .scenario-item { background: #f9f9f9; padding: 15px; border-radius: 6px; border-left: 4px solid #b69d5e; margin-bottom: 10px; display: flex; justify-content: space-between; align-items: center; }
        .scenario-info { flex: 1; }
        .scenario-name { font-weight: bold; color: #3d3d3d; }
        .scenario-meta { font-size: 12px; color: #999; margin-top: 5px; }
        .scenario-actions { display: flex; gap: 8px; }
        .scenario-actions button { padding: 6px 12px; font-size: 12px; }
        .active-badge { display: inline-block; background: #438148; color: white; padding: 3px 8px; border-radius: 3px; font-size: 11px; font-weight: bold; }
        
        /* Results */
        .results { background: #f9f9f9; padding: 20px; border-radius: 6px; border-left: 4px solid #b69d5e; }
        .result-row { display: flex; justify-content: spac