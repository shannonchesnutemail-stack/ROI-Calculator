) || cpl;
                const cplWinter = parseFloat(document.getElementById('newTerrCplWinter').value) || cpl;
                const blendedCpl = (cplSpring + cplSummer + cplFall + cplWinter) / 4;
                cplFields = { cplType, cplSpring, cplSummer, cplFall, cplWinter, blendedCpl };
            } else {
                cplFields = { cplType, cplSpring: cpl, cplSummer: cpl, cplFall: cpl, cplWinter: cpl, blendedCpl: cpl };
            }

            // Editing a manual field wipes any prior "derived from CPC" tag for this territory,
            // since the CPL is now a direct manual entry, not CPC ÷ CVR.
            const clearedDerivedFields = { cplSource: undefined, cpcType: undefined, cpcSpring: undefined, cpcSummer: undefined, cpcFall: undefined, cpcWinter: undefined, convRate: undefined };

            if (ctrType === 'blended') {
                const spring = parseFloat(document.getElementById('newTerrSpring').value) || 3.0;
                const summer = parseFloat(document.getElementById('newTerrSummer').value) || 3.0;
                const fall = parseFloat(document.getElementById('newTerrFall').value) || 3.0;
                const winter = parseFloat(document.getElementById('newTerrWinter').value) || 3.0;
                const blendedCtr = (spring + summer + fall + winter) / 4;
                TERRITORIES_DB[id] = { ...existing, ...clearedDerivedFields, name, cpl, ...cplFields, ctrType, ctr, spring, summer, fall, winter, blendedCtr, notes };
            } else {
                TERRITORIES_DB[id] = { ...existing, ...clearedDerivedFields, name, cpl, ...cplFields, ctrType, ctr, spring: ctr, summer: ctr, fall: ctr, winter: ctr, blendedCtr: ctr, notes };
            }

            localStorage.setItem('murrayTerritories', JSON.stringify(TERRITORIES_DB));

            resetTerritoryForm();
            loadTerritories();
            alert(editingId
                ? `✅ Territory updated: ${name} (${cplType === 'seasonal' ? 'Seasonal' : 'Flat'} CPL, ${ctrType === 'blended' ? 'Blended' : 'Flat'} CTR)`
                : `✅ Territory added: ${name} (${cplType === 'seasonal' ? 'Seasonal' : 'Flat'} CPL, ${ctrType === 'blended' ? 'Blended' : 'Flat'} CTR)`);
        }

        function deleteTerritory(id) {
            if (!confirm('Delete this territory?')) return;
            delete TERRITORIES_DB[id];
            localStorage.setItem('murrayTerritories', JSON.stringify(TERRITORIES_DB));
            loadTerritories();
        }

        function loadTerritories() {
            const list = document.getElementById('territoryList');
            const saved = JSON.parse(localStorage.getItem('murrayTerritories')) || {};
            Object.assign(TERRITORIES_DB, saved);

            list.innerHTML = Object.entries(TERRITORIES_DB).map(([id, t]) => {
                const season = getCurrentSeason();
                const isDerived = t.cplType === 'seasonal' && t.cplSource === 'derived' && t.cpcType === 'seasonal' && t.convRate;
                const derivedCpl = isDerived ? Math.round((t['cpc' + season] / (t.convRate / 100)) * 100) / 100 : null;
                return `
                <div class="territory-card">
                    <div class="territory-name">${t.name}</div>
                    <div class="territory-cpl">
                        ${isDerived ?
                            `Seasonal CPL (derived): $${derivedCpl} = $${t['cpc' + season]} CPC ÷ ${t.convRate}% CVR (${season})` :
                        t.cplType === 'seasonal' ? 
                            `Seasonal CPL (auto-detected): $${t['cpl' + season]} (${season})` : 
                            `Flat CPL: $${t.cpl}`}
                    </div>
                    ${isDerived ? `
                        <div class="territory-cpl" style="font-size: 11px; color: #999;">
                            CPC — Spring: $${t.cpcSpring} | Summer: $${t.cpcSummer} | Fall: $${t.cpcFall} | Winter: $${t.cpcWinter}
                        </div>
                    ` : t.cplType === 'seasonal' ? `
                        <div class="territory-cpl" style="font-size: 11px; color: #999;">
                            Spring: $${t.cplSpring} | Summer: $${t.cplSummer} | Fall: $${t.cplFall} | Winter: $${t.cplWinter}
                        </div>
                    ` : ''}
                    <div class="territory-cpl">
                        ${t.ctrType === 'blended' ? 
                            `Blended CTR: ${t.blendedCtr}% (annual avg)` : 
                            `Flat CTR: ${t.ctr}%`}
                    </div>
                    ${t.ctrType === 'blended' ? `
                        <div class="territory-cpl" style="font-size: 11px; color: #999;">
                            Spring: ${t.spring}% | Summer: ${t.summer}% | Fall: ${t.fall}% | Winter: ${t.winter}%
                        </div>
                    ` : ''}
                    <div class="territory-cpl" style="color: #999; font-style: italic; margin-top: 5px;">${t.notes || ''}</div>
                    <div class="territory-actions">
                        <button class="secondary" onclick="editTerritory('${id}')">✏️ Edit</button>
                        ${id.startsWith('custom-') ? `<button class="danger" onclick="deleteTerritory('${id}')">Delete</button>` : ''}
                    </div>
                </div>
            `;
            }).join('');
        }

        function updateComparisonSelects() {
            const scenarios = JSON.parse(localStorage.getItem('murrayScenarios')) || [];
            const options = scenarios.map(s => `<option value="${s.id}">${s.name}</option>`).join('');

            ['compareScen1', 'compareScen2', 'compareScen3'].forEach(id => {
                document.getElementById(id).innerHTML = '<option value="">-- Select --</option>' + options;
            });
        }

        function updateComparison() {
            const scenarios = JSON.parse(localStorage.getItem('murrayScenarios')) || [];
            const ids = ['