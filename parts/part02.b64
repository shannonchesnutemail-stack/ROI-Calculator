                            <span class="result-value"><span id="resultClosed">0</span></span>
                        </div>
                        <div class="result-row" style="padding-top: 15px; border-top: 2px solid #e0e0e0;">
                            <span class="result-label"><strong>Monthly Revenue</strong></span>
                            <span class="result-value highl