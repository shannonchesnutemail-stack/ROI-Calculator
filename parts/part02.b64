                            <span class="result-value"><span id="resultImpressions">N/A</span></span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Estimated Clicks (via CTR)</span>
                            <span class="result-value"><span id="resultClicks">N/A</span></span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Leads Generated</span>
                            <span class="result-value"><span id="resultLeads">0</span></span>
                        </div>
                        <div class="result-row">
                            <span class="result-label">Leads Approved (33%)</span>
                            <span class="result-value"><span id="resultApproved">0</span></span>
                        </div>
                        <div class="result-row">
