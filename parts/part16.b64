return;
            const cards = b.scenarios.map(s => `
                <div class="comparison-card">
                    <div class="comparison-title">${s.name}</div>
                    <div style="font-size: 12px; color: #999; margin-bottom: 15px;">${TERRITORIES_DB[s.territory]?.name || s.territory}</div>
                    <div style="font-size: 13px; line-height: 1.8;">
                        <div><strong>Monthly Spend:</strong> $${Math.round(s.adSpend).toLocaleString('en-US')}</div>
                        <div><strong>CPL:</strong> $${s.cpl}</div>
                        <div style="border-top: 1px solid #ddd; margin: 10px 0; padding-top: 10px;">
                            <div><strong>Monthly Leads:</strong> ${s.results.leads}</div>
                            <div><strong>Approved:</strong> ${s.results.approved}</div>
                            <div><strong>Closed:</strong> ${s.results.closed}</div>
                            <div><strong>Max Affordable CPL:</strong> $${s.results.maxCpl || '0'}</div>
                        </div>
                        <div style="border-top: 1px solid #ddd; margin: 10px 0; padding-top: 10px; color: #b69d5e; font-weight: bold;">
                            <div>Revenue: $${s.results.revenue} | Profit: $${s.results.profit} | ROI: ${s.results.roi}</div>
                        </div>
                    </div>
                </div>
            `).join('');
            alert(`Viewing "${b.name}" — see the popup comparison grid below.`);
            const list = document.getElementById('blueprintList');
            const detail = document.createElement('div');
            detail.className = 'comparison-grid';
            detail.style.marginTop = '20px';
            detail.innerHTML = cards;
            list.appendChild(detail);
        }

        function exportBlueprintPDF(id) {
            const b = findBlueprint(id);
            if (!b) return;
            const body = b.scenarios.map(scenarioPrintCardHtml).join('');
            printReport(
                `Advertising Blueprint — ${b.label}`,
                `Blueprint ID: BP-${b.uid} | Locked in: ${b.timestamp}`,
                body
            );
        }

        function deleteBlueprint(id) {
            if (!confirm('Delete this Advertising Blueprint? This cannot be undone.')) return;
            let blueprints = JSON.parse(localStorage.getItem('murrayBlueprints')) || [];
            blueprints = blueprints.filter(b => b.id !== id);
            localStorage.setItem('murrayBlueprints', JSON.stringify(blueprints));
            loadBlueprints();
        }

        function exportScenarios() {
            const scenarios = JSON.parse(localStorage.getItem('murrayScenarios')) || [];
            const dataStr = JSON.stringify(scenarios, null, 2);
            const dataBlob = new Blob([dataStr], { type: 'application/json' });
            const url = URL.createObjectURL(dataBlob);
            const link = document.createElement('a');
            link.href = url;
            link.download = `murray-scenarios-${new Date().toISOString().split('T')[0]}.json`;
            link.click();
        }

        function clearAllScenarios() {
            if (!confirm('Delete ALL scenarios? This cannot be undone.')) return;
            localStorage.removeItem('murrayScenarios');
            loadScenarios();
            updateComparisonSelects();
        }

        // KPI refresh cadence: last pulled Aug 20, 2026, refreshed every 30 days
        function updateNextRefreshDisplay() {
            const lastRefresh = new Date('2026-08-20');
            const nextRefresh = new Date(lastRefresh);
            nextRefresh.setDate(nextRefresh.getDate() + 30);
            const el = document.getElementById('nextRefreshDisplay');
            if (el) {
                el.textContent = `Last pulled: ${lastRefresh.toLocaleDateString('en-US')} — Next refresh due: ${nextRefresh.toLocaleDateString('en-US')}`;
            }
        }

        // Initialize
        loadTerritories();
        loadScenarios();
        updateComparisonSelects();
        loadBlueprints();
        updateNextRefreshDisplay();
        calculateROI();
    </script>
</body>
</html>