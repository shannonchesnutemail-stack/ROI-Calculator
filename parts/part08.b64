        const ACCULYNX_DATA = {
            approvalRate: 0.33,
            closeRate: 0.83
        };

        // Implied Cost Per Click, backed into from whatever CPL + Landing Page
        // Conversion Rate pair is currently active (CPL = CPC / CVR, rearranged).
        // This is what lets editing the Landing Page Conversion Rate field actually
        // move CPL — and therefore leads/revenue — instead of sitting there decorative.
        // Territory select and manual CPL edits both refresh it; manual convRate edits
        // consume it to re-derive CPL live.
        let impliedCPC = 0;

        function updateImpliedCpcFromCplAndConvRate() {
            const cpl = parseFloat(document.getElementById('cpl').value) || 0;
            const convRatePct = parseFloat(document.getElementById('lpConvRate').value) || 0;
            impliedCPC = (cpl > 0 && convRatePct > 0) ? cpl * (convRatePct / 100) : 0;
        }

        function recalcCplFromConvRate() {
            const convRatePct = parseFloat(document.getElementById('lpConvRate').value) || 0;
            if (impliedCPC > 0 && convRatePct > 0) {
                const newCpl = Math.round((impliedCPC / (convRatePct / 100)) * 100) / 100;
                document.getElementById('cpl').value = newCpl;
                const displayEl = document.getElementById('cplDisplay');
                displayEl.textContent = `$${newCpl} = $${impliedCPC.toFixed(2)} implied CPC ÷ ${convRatePct}% conversion rate (recalculated from your edit)`;
            }
        }

        function switchTab(tabName) {
            document.querySelectorAll('.tab-content').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.tab-button').forEach(el => el.classList.remove('active'));
            document.querySelectorAll('.header-util-btn').forEach(el => el.classList.remove('active'));
            document.getElementById(tabName).classList.add('active');
            if (typeof event !== 'undefined' && event && event.target) {
                event.target.classList.add('active');
            } else if (tabName === 'territories') {
                document.getElementById('hdrBtnTerritories').classList.add('active');
            } else if (tabName === 'info') {
                document.getElementById('hdrBtnInfo').classList.add('active');
            }
        }

        // Meteorological seasons: Spring Mar-May, Summer Jun-Aug, Fall Sep-Nov, Winter Dec-Feb
        function getCurrentSeason(d) {
            d = d || new Date();
            const m = d.getMonth() + 1;
            if (m >= 3 && m <= 5) return 'Spring';
            if (m >= 6 && m <= 8) return 'Summer';
            if (m >= 9 && m <= 11) return 'Fall';
            return 'Winter';
        }

        function updateTerritoryData() {
            const terrId = document.getElementById('territory').value;
            if (terrId && TERRITORIES_DB[terrId]) {
                const terr = TERRITORIES_DB[terrId];
                const cplType = terr.cplType || 'flat'; // fallback for old territories
                const season = getCurrentSeason();

                let effectiveCpl = terr.cpl;
                if (cplType === 'seasonal' && terr.cplSource === 'derived' && terr.cpcType === 'seasonal' && terr.convRate) {
                    // CPL = seaso